        requiredConcepts: ['Selection Sort', 'Comparisons tracking', 'Swaps tracking'],
        algorithm: [
          'Init comparisons = 0, swaps = 0',
          'For i = 0 to n - 2:',
          '  minIdx = i',
          '  For j = i + 1 to n - 1:',
          '    comparisons++',
          '    If arr[j] < arr[minIdx]: minIdx = j',
          '  If minIdx != i:',
          '    swap(arr[i], arr[minIdx])',
          '    swaps++',
          'Print sorted array, comparisons, and swaps',
        ],
        cCode: `#include <stdio.h>

int main() {
    int n, comparisons = 0, swaps = 0;
    printf("Enter n: ");
    scanf("%d", &n);
    int arr[n];
    for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
    
    for (int i = 0; i < n - 1; i++) {
        int minIdx = i;
        for (int j = i + 1; j < n; j++) {
            comparisons++;
            if (arr[j] < arr[minIdx]) {
                minIdx = j;
            }
        }
        if (minIdx != i) {
            int temp = arr[i];
            arr[i] = arr[minIdx];
            arr[minIdx] = temp;
            swaps++;
        }
    }
    
    printf("Sorted array: ");
    for (int i = 0; i < n; i++) printf("%d ", arr[i]);
    printf("\\n");
    printf("Total comparisons = %d\\n", comparisons);
    printf("Total swaps = %d\\n", swaps);
    return 0;
}`,
        cppCode: `#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n, comps = 0, sw = 0; cin >> n;
    vector<int> a(n);
    for (int &x : a) cin >> x;
    for (int i = 0; i < n - 1; i++) {
        int minIdx = i;
        for (int j = i + 1; j < n; j++) {
            comps++;
            if (a[j] < a[minIdx]) minIdx = j;
        }
        if (minIdx != i) { swap(a[i], a[minIdx]); sw++; }
    }
    for (int x : a) cout << x << " ";
    cout << "\\nComparisons: " << comps << " Swaps: " << sw << endl;
    return 0;
}`,
