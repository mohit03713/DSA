  timeComplexity: string
  spaceComplexity: string
  commonMistakes: string[]
  edgeCases: string[]
  vivaQuestions?: string[]
  relatedTopicId?: string
  isCompleted?: boolean
}

export interface DetailedLab {
  id: string
  subjectId: string
