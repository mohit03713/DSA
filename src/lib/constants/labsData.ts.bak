        cCode: `#include <stdio.h>

int main() {
    int n, key, foundIdx = -1;
    printf("Enter n: ");
    scanf("%d", &n);
    int arr[n];
    for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
    printf("Enter element to search and delete: ");
    scanf("%d", &key);
    
    for (int i = 0; i < n; i++) {
        if (arr[i] == key) {
            foundIdx = i;
            break;
        }
    }
    
    if (foundIdx != -1) {
        for (int j = foundIdx; j < n - 1; j++) {
            arr[j] = arr[j + 1];
        }
        n--;
        printf("Element %d deleted. Updated array: ", key);
        for (int i = 0; i < n; i++) printf("%d ", arr[i]);
        printf("\\n");
    } else {
        printf("Element %d not found in array.\\n", key);
    }
    return 0;
}`,
        cppCode: `#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n, key; cin >> n;
    vector<int> a(n);
    for (int &x : a) cin >> x;
    cin >> key;
    for (auto it = a.begin(); it != a.end(); ++it) {
        if (*it == key) {
            a.erase(it);
            cout << "Updated: ";
            for (int x : a) cout << x << " ";
            cout << endl;
            return 0;
        }
    }
    cout << "Not found" << endl;
    return 0;
}`,
