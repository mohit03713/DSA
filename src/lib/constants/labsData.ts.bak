        cCode: `#include <stdio.h>

int main() {
    int n;
    printf("Enter n: ");
    scanf("%d", &n);
    int arr[n];
    for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
    
    printf("Element frequencies:\\n");
    for (int i = 0; i < n; i++) {
        // Check if already counted
        int alreadyCounted = 0;
        for (int k = 0; k < i; k++) {
            if (arr[k] == arr[i]) {
                alreadyCounted = 1;
                break;
            }
        }
        if (alreadyCounted) continue;
        
        int count = 1;
        for (int j = i + 1; j < n; j++) {
            if (arr[j] == arr[i]) count++;
        }
        printf("%d appears %d time(s)\\n", arr[i], count);
    }
    return 0;
}`,
        cppCode: `#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n; cin >> n;
    vector<int> a(n);
    for (int &x : a) cin >> x;
    for (int i = 0; i < n; i++) {
        bool seen = false;
        for (int k = 0; k < i; k++) if (a[k] == a[i]) { seen = true; break; }
        if (seen) continue;
        int c = 1;
        for (int j = i + 1; j < n; j++) if (a[j] == a[i]) c++;
        cout << a[i] << " -> " << c << endl;
    }
    return 0;
}`,
