    int arr[n];
    printf("Enter array elements: ");
    for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
    printf("Enter target sum: ");
    scanf("%d", &target);
    
    printf("Pairs with sum %d:\\n", target);
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[i] + arr[j] == target) {
                printf("(%d, %d)\\n", arr[i], arr[j]);
                found++;
            }
        }
    }
    if (!found) printf("No pairs found.\\n");
