    for (int i = 2; i <= n; i++) s = (s + k) % i;
    cout << "Survivor: " << s + 1 << endl;
    return 0;
}`,
            timeComplexity: 'O(N)',
            spaceComplexity: 'O(1)',
            pros: ['Instant execution: O(N) time and O(1) space', 'No dynamic memory allocation required'],
